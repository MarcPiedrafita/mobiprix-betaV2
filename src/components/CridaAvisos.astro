---
import { t, type Idioma } from '../i18n/utils';
import { ruta } from '../lib/rutes';

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
---

<section class="crida">
  <h2 class="crida__titol">{t(idioma, 'home.avisTitol')}</h2>
  <p class="crida__text">{t(idioma, 'home.avisText')}</p>
  <a class="boton boton--principal boton--auto" href={ruta('avisos', idioma)}>
    {t(idioma, 'home.avisBoto')}
  </a>
</section>
