---
import NivellTara from './NivellTara.astro';
import { t, type Idioma } from '../i18n/utils';
import { NIVELLS_TARA } from '../lib/productes';

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
---

{/* Només aplica a les peces que tenen defecte, que són minoria. Per això va
    després de l'explicació dels motius i no al revés. */}
<section class="explicacio">
  <h2 class="seccio__titol">{t(idioma, 'nivells.explicacioTitol')}</h2>
  <p class="seccio__intro">{t(idioma, 'nivells.explicacioIntro')}</p>

  <div class="explicacio__graella explicacio__graella--tres">
    {NIVELLS_TARA.map((nivell) => (
      <article class="explicacio__fitxa">
        <NivellTara idioma={idioma} nivell={nivell} gran />
        <p class="explicacio__resum">{t(idioma, `nivells.${nivell}.resum`)}</p>
        <p class="explicacio__text">{t(idioma, `nivells.${nivell}.explicacio`)}</p>
      </article>
    ))}
  </div>
</section>
