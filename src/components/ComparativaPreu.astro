---
import { t, preu, type Idioma } from '../i18n/utils';
import type { ProducteVista } from '../lib/productes';

interface Props {
  idioma: Idioma;
  producte: ProducteVista;
}

const { idioma, producte } = Astro.props;
const { dades, estalvi, estalviPct } = producte;
---

<section class="comparativa" aria-label={t(idioma, 'comparativa.titol')}>
  <div class="comparativa__cel comparativa__cel--abans">
    <span class="comparativa__clau">{t(idioma, 'comparativa.abans')}</span>
    <span class="comparativa__valor">{preu(dades.preuOriginal, idioma)}</span>
  </div>
  <div class="comparativa__cel comparativa__cel--ara">
    <span class="comparativa__clau">{t(idioma, 'comparativa.ara')}</span>
    <span class="comparativa__valor">{preu(dades.preuOutlet, idioma)}</span>
  </div>
  <div class="comparativa__cel comparativa__cel--estalvi">
    <span class="comparativa__clau">{t(idioma, 'comparativa.estalvi')}</span>
    <span class="comparativa__valor">{preu(estalvi, idioma)} · −{estalviPct}%</span>
  </div>
</section>
