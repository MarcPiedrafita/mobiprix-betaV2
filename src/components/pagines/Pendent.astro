---
import Base from '../../layouts/Base.astro';
import { t, type Idioma } from '../../i18n/utils';
import { alternativesRuta, ruta, type ClauRuta } from '../../lib/rutes';

interface Props {
  idioma: Idioma;
  clau: ClauRuta;
}

const { idioma, clau } = Astro.props;
const titol = t(idioma, `titols.${clau}`);
---

<Base
  idioma={idioma}
  titol={`${titol} — Mobiprix`}
  descripcio={t(idioma, 'meta.home.descripcio')}
  alternatives={alternativesRuta(clau)}
  rutaActiva={clau}
>
  <section class="hero hero--compacto">
    <div class="contenedor">
      <h1 class="hero__titulo">{titol}</h1>
    </div>
  </section>

  <div class="contenedor contenedor--estrecho">
    <div class="vacio">
      <p class="vacio__titulo">{t(idioma, 'pendent.titol')}</p>
      <p class="vacio__texto">{t(idioma, 'pendent.text')}</p>
      <div class="vacio__acciones">
        <a class="boton boton--secundario boton--auto" href={ruta('outlet', idioma)}>
          {t(idioma, 'pendent.tornar')}
        </a>
      </div>
    </div>
  </div>
</Base>
