---
import Base from '../../layouts/Base.astro';
import { t, type Idioma } from '../../i18n/utils';
import { alternativesRuta, ruta } from '../../lib/rutes';
import { carregaBotigues, carregaCategories, carregaCataleg, facetes } from '../../lib/productes';

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;

const [categories, botigues, cataleg] = await Promise.all([
  carregaCategories(),
  carregaBotigues(),
  carregaCataleg(),
]);
const { preuMax } = facetes(cataleg, idioma);

const TOTS = 'tots';
---

<Base
  idioma={idioma}
  titol={t(idioma, 'meta.avisos.titol')}
  descripcio={t(idioma, 'meta.avisos.descripcio')}
  alternatives={alternativesRuta('avisos')}
  rutaActiva="avisos"
>
  <section class="hero hero--compacto">
    <div class="contenedor">
      <p class="etiqueta-premium">{t(idioma, 'avisos.premium')}</p>
      <h1 class="hero__titulo">{t(idioma, 'avisos.titol')}</h1>
      <p class="hero__subtitulo">{t(idioma, 'avisos.intro')}</p>
    </div>
  </section>

  <div class="contenedor contenedor--estrecho">
    <div class="seccio" data-avis>
      {/* Pantalla 1: el formulari. */}
      <div data-avis-form>
        <form class="formulari" data-formulari-avis novalidate>
          <h2 class="estat-peca__titol">{t(idioma, 'avisos.queBusques')}</h2>

          <div class="formulari__fila">
            <div class="formulari__camp">
              <label class="formulari__etiqueta" for="a-categoria">{t(idioma, 'avisos.categoria')}</label>
              <select class="select" id="a-categoria">
                <option value={TOTS}>{t(idioma, 'avisos.qualsevolCategoria')}</option>
                {categories.map((c) => <option value={c.id}>{c.data.nom[idioma]}</option>)}
              </select>
            </div>

            <div class="formulari__camp">
              <label class="formulari__etiqueta" for="a-botiga">{t(idioma, 'avisos.botiga')}</label>
              <select class="select" id="a-botiga">
                <option value={TOTS}>{t(idioma, 'avisos.qualsevolBotiga')}</option>
                {botigues.map((b) => <option value={b.id}>{b.data.nom}</option>)}
              </select>
            </div>
          </div>

          <div class="formulari__camp">
            <label class="formulari__etiqueta" for="a-preu">{t(idioma, 'avisos.preuFins')}</label>
            <input class="rang__camp" type="number" id="a-preu" inputmode="numeric"
                   min="0" max={preuMax} step="10" placeholder={`${preuMax} €`} />
          </div>

          <div class="formulari__camp">
            <label class="formulari__etiqueta" for="a-email">{t(idioma, 'avisos.email')}</label>
            <input class="formulari__input" type="email" id="a-email" autocomplete="email" required />
          </div>

          <button type="submit" class="boton boton--principal formulari__enviar">
            {t(idioma, 'avisos.boto')}
          </button>
        </form>
      </div>

      {/* Pantalla 2: la confirmació. Simulada: no es desa res ni s'envia res. */}
      <div class="confirmacio" data-avis-ok hidden>
        <div class="confirmacio__icona" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
               stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
        </div>
        <h2 class="confirmacio__titol">{t(idioma, 'avisos.okTitol')}</h2>
        <p class="confirmacio__text" data-avis-text
           data-plantilla={t(idioma, 'avisos.okText', { email: '{email}' })}></p>
        <p class="confirmacio__enrutat" data-avis-resum
           data-plantilla={t(idioma, 'avisos.okResum', { resum: '{resum}' })}
           data-tot={t(idioma, 'avisos.resumTot')}
           data-fins={t(idioma, 'avisos.resumFins', { n: '{n}' })}></p>
        <p class="confirmacio__nota">{t(idioma, 'avisos.okNota')}</p>
        <div class="vacio__acciones">
          <button type="button" class="boton boton--secundario boton--auto" data-avis-altre>
            {t(idioma, 'avisos.okAltre')}
          </button>
          <a class="boton boton--principal boton--auto" href={ruta('outlet', idioma)}>
            {t(idioma, 'reserva.okTornar')}
          </a>
        </div>
      </div>
    </div>
  </div>
</Base>

<script>
  import '../../scripts/avisos';
</script>
