---
import Base from '../../layouts/Base.astro';
import CridaAvisos from '../CridaAvisos.astro';
import { t, type Idioma } from '../../i18n/utils';
import { alternativesRuta } from '../../lib/rutes';

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;

const PREGUNTES = ['q1', 'q2', 'q3', 'q4', 'q5', 'q6', 'q7', 'q8'] as const;
---

<Base
  idioma={idioma}
  titol={t(idioma, 'meta.faq.titol')}
  descripcio={t(idioma, 'meta.faq.descripcio')}
  alternatives={alternativesRuta('faq')}
  rutaActiva="faq"
>
  <section class="hero hero--compacto">
    <div class="contenedor">
      <h1 class="hero__titulo">{t(idioma, 'titols.faq')}</h1>
      <p class="hero__subtitulo">{t(idioma, 'faq.intro')}</p>
    </div>
  </section>

  <div class="contenedor contenedor--estrecho">
    <div class="seccio">
      {/* <details> natiu: obre i tanca sense JavaScript i el navegador ja el
          fa accessible i cercable amb Ctrl+F. */}
      <div class="faq">
        {PREGUNTES.map((q) => (
          <details class="faq__item">
            <summary class="faq__pregunta">{t(idioma, `faq.${q}.p`)}</summary>
            <p class="faq__resposta">{t(idioma, `faq.${q}.r`)}</p>
          </details>
        ))}
      </div>
    </div>

    <div class="seccio">
      <CridaAvisos idioma={idioma} />
    </div>
  </div>
</Base>
