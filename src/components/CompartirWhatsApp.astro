---
import { t, preu, type Idioma } from '../i18n/utils';
import { rutaProducte } from '../lib/rutes';
import type { ProducteVista } from '../lib/productes';

interface Props {
  idioma: Idioma;
  producte: ProducteVista;
}

const { idioma, producte } = Astro.props;
const { dades, slug } = producte;

/* Molt utilitzat en comprar moble: s'envia la peça a qui hagi de dir-hi la
   seva. És un enllaç wa.me, no una integració: no truca a cap servei ni
   carrega res de tercers. La URL ha de ser absoluta perquè funcioni fora del
   navegador. */
const base = Astro.site ?? new URL('http://localhost:4321');
const url = new URL(rutaProducte(slug, idioma), base).href;

const missatge = t(idioma, 'fitxa.compartirText', {
  nom: dades.nom[idioma],
  ref: dades.ref,
  preu: preu(dades.preuOutlet, idioma),
  url,
});

const enllac = `https://wa.me/?text=${encodeURIComponent(missatge)}`;
---

<a
  class="boton boton--secundario"
  href={enllac}
  target="_blank"
  rel="noopener noreferrer"
  data-whatsapp
>
  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M17.47 14.38c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.64.07-.3-.15-1.25-.46-2.38-1.47-.88-.78-1.47-1.75-1.64-2.05-.17-.3-.02-.46.13-.6.13-.14.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.6-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.01-1.04 2.47s1.06 2.86 1.21 3.06c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.69.63.71.22 1.36.19 1.87.12.57-.09 1.75-.72 2-1.41.25-.69.25-1.28.17-1.41-.07-.13-.27-.2-.57-.35Z"/>
    <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.87 9.87 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91C21.96 6.45 17.5 2 12.04 2Zm0 18.02h-.01a8.2 8.2 0 0 1-4.18-1.15l-.3-.18-3.11.82.83-3.04-.2-.31a8.17 8.17 0 0 1-1.25-4.36c0-4.53 3.69-8.22 8.23-8.22 2.2 0 4.26.86 5.81 2.41a8.17 8.17 0 0 1 2.41 5.82c0 4.54-3.7 8.21-8.23 8.21Z"/>
  </svg>
  {t(idioma, 'fitxa.compartir')}
</a>
