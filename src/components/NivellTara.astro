---
import { t, type Idioma } from '../i18n/utils';

interface Props {
  idioma: Idioma;
  nivell: 'lleu' | 'mitjana' | 'notable';
  /** Mida gran per a la fitxa; la petita és per a la targeta. */
  gran?: boolean;
}

const { idioma, nivell, gran = false } = Astro.props;

/* Tres punts, tants plens com pesa el nivell: es llegeix d'un cop d'ull i
   sense dependre només del color. */
const PES = { lleu: 1, mitjana: 2, notable: 3 } as const;
const plens = PES[nivell];
---

<span
  class:list={['nivell', `nivell--${nivell}`, { 'nivell--gran': gran }]}
  title={t(idioma, `nivells.${nivell}.resum`)}
>
  <span class="nivell__punts" aria-hidden="true">
    {[1, 2, 3].map((i) => (
      <span class:list={['nivell__punt', { 'nivell__punt--ple': i <= plens }]}></span>
    ))}
  </span>
  {t(idioma, `nivells.${nivell}.nom`)}
</span>
